# ---------------------------------------------------------
# ResumeAI backend environment variables
# Local: copy this file to ".env" and fill in the values.
# Render: add the same variables in Dashboard -> Environment.
# NEVER commit the real .env file.
# ---------------------------------------------------------

# Which AI engine to use: gemini | groq | mock
#   gemini -> Google Gemini free tier (recommended)
#   groq   -> Groq free tier (fast Llama models)
#   mock   -> built-in demo engine, no key needed
AI_PROVIDER=mock

# Free key from https://aistudio.google.com/apikey  (needed when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free key from https://console.groq.com/keys  (needed when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# If true, a clearly labelled demo analysis is shown when the free AI quota
# is exhausted instead of an error. Handy for live presentations.
FALLBACK_TO_MOCK=false

# Max upload size in MB
MAX_FILE_SIZE_MB=5

# CORS: comma separated list of allowed frontend origins.
# After deploying, add your Vercel URL, e.g. https://resumeai.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
